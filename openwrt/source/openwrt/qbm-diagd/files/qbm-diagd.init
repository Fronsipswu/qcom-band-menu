#!/bin/sh /etc/rc.common
# qbm-diagd: modem statistics daemon (Qualcomm DIAG, Fibocom FM350 debug port)

START=95
STOP=10
USE_PROCD=1
PROG=/usr/sbin/qbm-diagd

start_service() {
	local enabled device at trim

	config_load qbm-diagd
	config_get_bool enabled main enabled 0
	config_get device main device auto
	config_get at main at_device auto
	config_get_bool trim main mtk_trim 1
	[ "$enabled" = 1 ] || return 0

	procd_open_instance
	procd_set_param command "$PROG" -dev "$device" -at "$at" -mtk-trim "$trim"
	# The daemon reopens the port by itself; respawn only covers crashes.
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger qbm-diagd
}
