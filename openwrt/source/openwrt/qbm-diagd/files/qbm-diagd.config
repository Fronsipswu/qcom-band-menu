config qbm-diagd 'main'
	# 1: run the daemon. It owns the modem's DIAG port while it runs.
	option enabled '1'
	# 'auto': the first /dev/ttyUSB* that answers as DIAG. Or a port,
	# e.g. '/dev/ttyUSB0', to keep it from probing the other ports.
	option device 'auto'
	# QMI port for band and cell locking (qbm-qmi): 'auto' = the first
	# /dev/cdc-wdm*. Shared with uqmi; qbm-qmi only opens it per request.
	option qmi_device 'auto'
	# AT port for modem control (e.g. Airplane mode): 'auto' = tries each
	# port until one answers AT+CGMM. Or a port, e.g. '/dev/ttyUSB2'.
	option at_device 'auto'
	# Network interface (netifd, proto xmm) that Network > Reconnect brings
	# down and up, which refreshes the IP address. 'auto' = the first
	# interface with proto xmm. Or a name, e.g. 'wwan'.
	option netif 'auto'
	# Fibocom FM350 only: 1 = trim the modem's DHL trace filters, so its
	# debug port carries ~36 KB/s instead of ~4.4 MB/s. The filters are
	# saved in the modem (NVRAM): written once, and only while they differ.
	# Settings > Restore MTK DIAG profile writes the modem's originals back.
	option mtk_trim '1'
