#!/bin/sh
# rpcd backend for luci-app-qbm-diagd:
#   stats, status  forwarded to the running qbm-diagd (DIAG statistics; its
#                  socket is abstract, which BusyBox tools cannot reach)
#   ports          the modem's USB serial and QMI ports, for Settings
#   qmi_query      read-only qbm-qmi requests (bands, hardware, cell locks)
#   qmi            any qbm-qmi request (band, cell and PLMN locks, re-attach);
#                  granted by the ACL's write section only
#   serving        the serving-cell reads (NAS SYS/SIG/CELL_LOCATION/RF band/
#                  ARFCN list/LTE CA info), raw, for the Network page
#   operator       the operator name for a PLMN (NAS GET_PLMN_NAME and
#                  GET_HOME_NETWORK), raw
#   at_serving     the FM350's serving cell (AT+COPS?, AT+GTCCINFO?)
#   at_serving_qcom  the serving cell over AT, for a Qualcomm modem whose USB
#                  mode (RNDIS, ECM, MBIM) has no QMI port: Quectel's
#                  AT+QENG/QCAINFO/QSPN, and the 3GPP AT+CEREG?/C5GREG?/COPS?
# qbm-qmi gets the request as one argument; nothing is evaluated by a shell.

. /usr/share/libubox/jshn.sh

BIN=/usr/sbin/qbm-diagd
QMI=/usr/sbin/qbm-qmi

query() {
	local out
	if [ -x "$BIN" ]; then
		out=$("$BIN" -query "$1" 2>/dev/null)
		# rpcd must always get JSON: a binary that cannot run would otherwise
		# leave the page with an opaque "unknown error".
		if [ -n "$out" ]; then
			echo "$out"
		else
			echo '{"ok":false,"error":"qbm-diagd did not run"}'
		fi
	else
		echo '{"ok":false,"error":"qbm-diagd is not installed"}'
	fi
}

qmi_dev() {
	local d x
	d=$(uci -q get qbm-diagd.main.qmi_device)
	if [ -z "$d" ] || [ "$d" = auto ]; then
		d=/dev/cdc-wdm0
		for x in /dev/cdc-wdm*; do [ -e "$x" ] && { d=$x; break; }; done
	fi
	echo "$d"
}

qmi() {
	local sim=$1 req=$2 out
	[ "$sim" = 2 ] || sim=1
	if [ ! -x "$QMI" ]; then
		echo '{"ok":false,"error":{"stage":"daemon","message":"qbm-qmi is not installed"}}'
		return
	fi
	case "$req" in
		"{"*) ;;
		*) echo '{"ok":false,"error":{"stage":"bad_request","message":"request must be a JSON object"}}'; return ;;
	esac
	out=$("$QMI" -dev "$(qmi_dev)" -sim "$sim" "$req" 2>/dev/null)
	if [ -n "$out" ]; then
		echo "$out"
	else
		echo '{"ok":false,"error":{"stage":"daemon","message":"no reply from qbm-qmi"}}'
	fi
}

# GET_PLMN_NAME request payload for an MCC/MNC, as the app's plmnNamePayload:
# TLV 0x01 (mcc u16, mnc u16), TLV 0x11 (MNC includes PCS digit).
plmn_payload() {
	local mcc=$1 mnc=$2 pcs=0
	[ ${#mnc} = 3 ] && pcs=1
	mcc=$(expr "$mcc" + 0); mnc=$(expr "$mnc" + 0)
	printf '010400%02x%02x%02x%02x110100%02x' $((mcc & 255)) $((mcc >> 8)) $((mnc & 255)) $((mnc >> 8)) $pcs
}

read_attr() {
	[ -r "$1" ] && cat "$1" 2>/dev/null
}

CR=$(printf '\r')

# One AT conversation at a time: the Network page polls every second and the
# reconnect job polls AT+CGATT?, and two commands interleaved on the port get
# each other's replies. flock is released by the kernel when the holder exits,
# so a killed call can't leave the port locked. Nested calls (at_dev probing
# inside a session) share the outer lock. BusyBox flock has no -w, so the
# wait is a loop of non-blocking tries, for up to 15 s.
AT_DEPTH=0
at_lock() {
	local until
	AT_DEPTH=$((AT_DEPTH + 1))
	[ $AT_DEPTH -gt 1 ] && return 0
	command -v flock >/dev/null 2>&1 || return 0
	exec 9>/tmp/qbm-at.flock
	until=$(($(date +%s) + 15))
	while :; do
		flock -n 9 2>/dev/null && return 0
		[ "$(date +%s)" -lt $until ] || break
		sleep 0.2 2>/dev/null || sleep 1
	done
	exec 9>&-
	AT_DEPTH=0
	return 1
}

at_unlock() {
	[ $AT_DEPTH -gt 0 ] || return 0
	AT_DEPTH=$((AT_DEPTH - 1))
	[ $AT_DEPTH -eq 0 ] && exec 9>&-
	return 0
}

# AT log, for debugging: every session and command with its raw reply, in
# /tmp/qbm-at.log (kept under 256 KB). Off unless qbm-diagd.main.at_log=1.
# AT_WHO is the rpcd method that started the session.
AT_LOG=/tmp/qbm-at.log
AT_LOG_ON=$(uci -q get qbm-diagd.main.at_log)
at_log() {
	local size
	[ "$AT_LOG_ON" = 1 ] || return 0
	size=$(wc -c 2>/dev/null < "$AT_LOG")
	if [ "${size:-0}" -gt 262144 ]; then
		tail -c 131072 "$AT_LOG" > "$AT_LOG.tmp" 2>/dev/null && mv "$AT_LOG.tmp" "$AT_LOG"
	fi
	echo "$(date '+%m-%d %H:%M:%S') [$$ ${AT_WHO:-?}] $*" >> "$AT_LOG"
}

# Other processes with the AT port open (pid:name), for the log.
at_holders() {
	local p out=""
	for p in /proc/[0-9]*; do
		[ "${p#/proc/}" = "$$" ] && continue
		ls -l "$p/fd" 2>/dev/null | grep -q " -> $1\$" && out="$out ${p#/proc/}:$(cat "$p/comm" 2>/dev/null)"
	done
	echo "${out:- none}"
}

# Sends $1 on fd 3 and prints the reply lines up to the final result code
# (unsolicited lines too); $2 is the per-line timeout in seconds (default 2).
# Returns 0 when a final result code came.
at_cmd() {
	local line i=0 rc=1 log="" t0
	t0=$(date +%s)
	printf '\r\n%s\r\n' "$1" >&3
	while [ $i -lt 40 ]; do
		i=$((i + 1))
		read -t "${2:-2}" -r line <&3 || { log="$log <timeout>"; break; }
		line=${line%%"$CR"*}    # the echo ends in CR CR LF
		[ -n "$line" ] || continue
		echo "$line"
		log="$log | $line"
		case "$line" in OK|OK\ *|ERROR|ERROR\ *|+CME\ ERROR*|+CMS\ ERROR*) rc=0; break ;; esac
	done
	at_log "> $1 ($(($(date +%s) - t0))s)$log"
	[ "$AT_LOG_ON" = 1 ] && case "$log" in
		*'<timeout>'|*'| ERROR'|*'| ERROR '*|*'+CME ERROR'*) at_log "  holders of ${AT_DEV:-?}:$(at_holders "${AT_DEV:-/dev/null}")" ;;
	esac
	return $rc
}

# Raw mode, no echo. Without it the tty echoes the modem's own output back
# into the modem (AT+QAT+QAT+Q...), and replies come back garbled and one
# command late. OpenWrt's BusyBox has no stty: the package depends on
# coreutils-stty.
tty_setup() {
	if ! command -v stty >/dev/null 2>&1; then
		logger -t qbm-diagd "no stty (install coreutils-stty): $1 left in cooked mode, AT replies will be garbled"
		at_log "WARNING: no stty (install coreutils-stty): $1 left in cooked mode, replies will be garbled"
		return 0
	fi
	# stty exits 1 when any one setting didn't take (USB serial ignores the
	# speed), though raw and -echo did; log what it said.
	local err
	err=$(stty -F "$1" 115200 raw -echo 2>&1) || at_log "stty on $1: ${err:-exit $?}"
	return 0
}

# Takes the lock and opens the AT port on fd 3 (AT_DEV). On failure, AT_ERR
# says why and nothing is held.
at_open() {
	local t0
	t0=$(date +%s)
	at_lock || { AT_ERR="AT port busy"; at_log "lock: busy after 15 s"; return 1; }
	AT_DEV=$(at_dev)
	if [ -z "$AT_DEV" ] || [ ! -c "$AT_DEV" ]; then
		AT_ERR="AT port not found or not available"
		at_log "open: no AT port (got '$AT_DEV')"
		at_unlock
		return 1
	fi
	tty_setup "$AT_DEV"
	exec 3<>"$AT_DEV" 2>/dev/null || { AT_ERR="Failed to open AT port $AT_DEV"; at_log "open: $AT_ERR"; at_unlock; return 1; }
	at_log "open $AT_DEV (lock wait $(($(date +%s) - t0))s, flock: $(command -v flock || echo none))"
	return 0
}

at_close() {
	exec 3<&- 3>&-
	at_unlock
}

# 0 if the tty answers AT+CGMM with a final result code.
at_probe_port() {
	local dev=$1 ok=1
	[ -c "$dev" ] || return 1
	at_lock || return 1
	tty_setup "$dev"
	AT_DEV=$dev
	at_log "probe $dev"
	if exec 3<>"$dev" 2>/dev/null; then
		at_cmd "AT+CGMM" 1 >/dev/null && ok=0
		exec 3<&- 3>&-
	fi
	at_unlock
	return $ok
}

find_at_port() {
	local cached p diag_dev cand="" rest=""

	# 1. The port found before, while the same USB device is behind it.
	if [ -f /tmp/qbm-at-device ]; then
		cached=$(sed -n 1p /tmp/qbm-at-device 2>/dev/null)
		if [ -n "$cached" ] && [ -c "$cached" ] && [ -n "$(tty_usb_sig "$cached")" ] &&
		   [ "$(tty_usb_sig "$cached")" = "$(sed -n 2p /tmp/qbm-at-device 2>/dev/null)" ]; then
			echo "$cached"
			return 0
		fi
		rm -f /tmp/qbm-at-device 2>/dev/null
	fi

	# 2. Gather candidate ports
	diag_dev=$(uci -q get qbm-diagd.main.device)
	[ "$diag_dev" = auto ] && diag_dev=""

	for p in /sys/class/tty/ttyUSB* /sys/class/tty/ttyACM*; do
		[ -e "$p/device" ] || continue
		local name=${p##*/}
		local dev="/dev/$name"
		[ -c "$dev" ] || continue
		[ "$dev" = "$cached" ] && continue

		# Fibocom FM350 (MediaTek, USB 0e8d): AT is interface 06; 09 is the
		# debug port qbm-diagd reads, which must not get AT text.
		local vid intf
		vid=$(read_attr "$p/device/../../idVendor")
		intf=$(read_attr "$p/device/../bInterfaceNumber")
		if [ "$vid" = 0e8d ]; then
			[ "$intf" = 09 ] && continue
			[ "$intf" = 06 ] && { cand="$dev $cand"; continue; }
		fi

		if [ -n "$diag_dev" ] && [ "$dev" = "$diag_dev" ]; then
			rest="$rest $dev"
		elif [ "$name" = "ttyUSB2" ] || [ "$name" = "ttyACM2" ]; then
			cand="$dev $cand"
		else
			cand="$cand $dev"
		fi
	done

	for p in $cand $rest; do
		if at_probe_port "$p"; then
			printf '%s\n%s\n' "$p" "$(tty_usb_sig "$p")" > /tmp/qbm-at-device
			echo "$p"
			return 0
		fi
	done

	return 1
}

at_dev() {
	local d
	d=$(uci -q get qbm-diagd.main.at_device)
	if [ -n "$d" ] && [ "$d" != auto ] && [ -e "$d" ]; then
		echo "$d"
		return 0
	fi
	find_at_port
}

airplane_mode() {
	local r4 r1
	at_open || { at_fail "$AT_ERR"; return; }
	r4=$(at_cmd "AT+CFUN=4" | tr '\n' ' ')
	sleep 1
	r1=$(at_cmd "AT+CFUN=1" | tr '\n' ' ')
	at_close

	json_init
	json_add_boolean ok 1
	json_add_string device "$AT_DEV"
	json_add_string cfun4 "$r4"
	json_add_string cfun1 "$r1"
	json_dump
}

# Name of the netifd interface on the xmm protocol that belongs to the modem
# airplane mode toggles: qbm-diagd.main.netif if set, else the xmm interface
# whose device is the AT port (a router may have several xmm interfaces).
xmm_iface() {
	local name at s dev
	name=$(uci -q get qbm-diagd.main.netif)
	if [ -n "$name" ] && [ "$name" != auto ]; then
		echo "$name"
		return 0
	fi
	at=$(at_dev)
	at=${at##*/}
	[ -n "$at" ] || return 1
	for s in $(uci -q show network | sed -n "s/^network\.\([^.=]*\)\.proto='xmm'\$/\1/p"); do
		dev=$(uci -q get network.$s.device)
		dev=${dev##*/}
		if [ "$dev" = "$at" ]; then
			echo "$s"
			return 0
		fi
	done
	return 1
}

# Prints "true" while the netifd interface is up.
iface_up() {
	ubus call "network.interface.$1" status 2>/dev/null | jsonfilter -e '@.up' 2>/dev/null
}

# Like at_run, but prints the raw reply lines (for parsing in this file).
at_raw() {
	local cmd
	at_open || return 1
	for cmd in "$@"; do
		at_cmd "$cmd"
	done
	at_close
}

# netifd's protocol update for an interface that stays up: the same calls
# qmiq-event makes. The subshell keeps netifd-proto.sh out of rpcd.
netifd_update() {
	local iface=$1 dev=$2 addr=$3 gw=$4 dns1=$5 dns2=$6
	(
		INCLUDE_ONLY=1
		. /lib/functions.sh
		. /lib/netifd/netifd-proto.sh
		proto_init_update "$dev" 1
		proto_add_ipv4_address "$addr" 24
		proto_add_ipv4_route 0.0.0.0 0 "$gw" "$addr"
		[ -n "$dns1" ] && proto_add_dns_server "$dns1"
		[ -n "$dns2" ] && proto_add_dns_server "$dns2"
		proto_send_update "$iface"
	)
}

# Re-activates the PDP context and hands the new address to netifd while the
# interface stays up. Returns 1 if the modem gives no address; the caller then
# restarts the interface instead.
refresh_address() {
	local iface=$1 cid apn pdp dev r addr gw dns dns1 dns2 a g
	cid=$(uci -q get network.$iface.profile)
	cid=${cid:-1}
	apn=$(uci -q get network.$iface.apn)
	pdp=$(uci -q get network.$iface.pdp | tr a-z A-Z)
	case "$pdp" in IP|IPV6|IPV4V6) ;; *) pdp=IP ;; esac
	dev=$(ubus call "network.interface.$iface" status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)
	[ -n "$dev" ] || return 1

	set -- "AT+CGACT=1,$cid" "AT+CGPADDR=$cid" "AT+GTDNS=$cid"
	[ -n "$apn" ] && set -- "AT+CGDCONT=$cid,\"$pdp\",\"$apn\"" "$@"
	r=$(at_raw "$@")
	addr=$(echo "$r" | sed -n 's/^+CGPADDR: [0-9]*,"\([0-9]*\.[0-9]*\.[0-9]*\.[0-9]*\)".*/\1/p' | head -n 1)
	[ -n "$addr" ] && [ "$addr" != 0.0.0.0 ] || return 1
	gw=$(echo "$addr" | awk -F. '{print $1"."$2"."$3".1"}')
	dns=$(echo "$r" | sed -n 's/^+GTDNS: [0-9]*,"\([0-9]*\.[0-9]*\.[0-9]*\.[0-9]*\)","\([0-9]*\.[0-9]*\.[0-9]*\.[0-9]*\)".*/\1 \2/p' | head -n 1)
	set -- $dns
	dns1=$1
	dns2=$2

	netifd_update "$iface" "$dev" "$addr" "$gw" "$dns1" "$dns2" || return 1

	# netifd replaces the address and default route it manages; drop any left
	# over from the previous session so the device carries only the new one.
	ip -4 -o addr show dev "$dev" | awk '{print $4}' | while read a; do
		[ "${a%/*}" = "$addr" ] || ip addr del "$a" dev "$dev"
	done
	ip -4 route show default dev "$dev" | awk '$2 == "via" {print $3}' | while read g; do
		[ "$g" = "$gw" ] || ip route del default via "$g" dev "$dev"
	done
	ip -4 addr show dev "$dev" | grep -q "inet $addr/"
}

# Waits for the modem to attach, then hands the new address to netifd while the
# interface stays up. The interface is restarted only if that fails. $2 is a
# settle time: after a band change the session drops a moment later, so the
# attach check must not see the state from before the change.
refresh_job() {
	local iface=$1 settle=${2:-0} i attached
	[ "$settle" -gt 0 ] && sleep "$settle"

	i=0
	while [ $i -lt 60 ]; do
		i=$((i + 1))
		attached=$(at_run "AT+CGATT?" | jsonfilter -e '@.replies[0]' 2>/dev/null)
		case "$attached" in *"+CGATT: 1"*) break ;; esac
		sleep 2
	done

	if [ "$(iface_up "$iface")" = true ] && refresh_address "$iface"; then
		logger -t qbm-diagd "reconnect: $iface address updated in place"
		return 0
	fi

	logger -t qbm-diagd "reconnect: in-place update failed, restarting $iface"
	ifdown "$iface"
	i=0
	while [ $i -lt 20 ] && [ "$(iface_up "$iface")" = true ]; do
		i=$((i + 1))
		sleep 1
	done
	ifup "$iface"
}

# Network > Reconnect (and Band Locking's Re-attach): airplane mode is toggled
# (CFUN 4, 1), then the address is refreshed.
reconnect_job() {
	local iface=$1 ok
	ok=$(airplane_mode | jsonfilter -e '@.ok' 2>/dev/null)
	logger -t qbm-diagd "reconnect: airplane mode toggled (ok=${ok:-unknown})"
	refresh_job "$iface" 0
}

# Starts a job ($1, with the extra arguments after it) in the background and
# returns at once: the sequence takes about a minute, longer than a browser RPC
# call should wait. One job at a time.
start_job() {
	local job=$1 iface lock=/tmp/qbm-reconnect.lock
	shift
	iface=$(xmm_iface)
	if [ -z "$iface" ]; then
		at_fail "No xmm network interface uses the AT port (set qbm-diagd.main.netif)"
		return
	fi
	if ! mkdir "$lock" 2>/dev/null; then
		at_fail "A reconnect is already running"
		return
	fi
	( "$job" "$iface" "$@"; rmdir "$lock" ) </dev/null >/dev/null 2>&1 &

	json_init
	json_add_boolean ok 1
	json_add_string interface "$iface"
	json_dump
}

reconnect_start() {
	start_job reconnect_job
}

# After a band change: the 5 s settle lets the modem drop the old session first.
refresh_start() {
	start_job refresh_job 5
}

at_send() {
	local cmd=${1:-AT} resp
	at_open || { at_fail "$AT_ERR"; return; }
	resp=$(at_cmd "$cmd" | tr '
' ' ')
	at_close

	json_init
	json_add_boolean ok 1
	json_add_string device "$AT_DEV"
	json_add_string response "$resp"
	json_dump
}

at_fail() {
	json_init
	json_add_boolean ok 0
	json_add_object error
	json_add_string message "$1"
	json_close_object
	json_dump
}

# Runs AT commands in one session on the AT port: {"ok":true,"device":...,
# "replies":[...]}, each reply the lines up to OK/ERROR (unsolicited lines too).
at_run() {
	local cmd resp
	at_open || { at_fail "$AT_ERR"; return; }
	json_init
	json_add_boolean ok 1
	json_add_string device "$AT_DEV"
	json_add_array replies
	for cmd in "$@"; do
		resp=$(at_cmd "$cmd")
		[ -n "$resp" ] && resp="$resp
"
		json_add_string "" "$resp"
	done
	json_close_array
	at_close
	json_dump
}

# USB identity of a tty (/dev/ttyUSB*, /dev/ttyACM*): device node, VID:PID,
# and busnum:devnum. Changes whenever a different modem is plugged in or the
# same modem re-enumerates, even if it gets the same /dev/ttyUSBn name.
tty_usb_sig() {
	local name=${1##*/} dir vid pid bus dnum i=0
	[ -e "/sys/class/tty/$name/device" ] || return 1
	dir=$(readlink -f "/sys/class/tty/$name/device")
	while [ $i -lt 4 ] && [ -n "$dir" ] && [ "$dir" != "/" ]; do
		if [ -r "$dir/idVendor" ]; then
			vid=$(read_attr "$dir/idVendor")
			pid=$(read_attr "$dir/idProduct")
			bus=$(read_attr "$dir/busnum")
			dnum=$(read_attr "$dir/devnum")
			[ -n "$vid" ] && [ -n "$pid" ] && echo "$1|$vid:$pid|$bus:$dnum" && return 0
		fi
		dir=${dir%/*}
		i=$((i + 1))
	done
	return 1
}

# The modem's identity (AT+CGMI/CGMM/GMR), kept in /tmp once it answered,
# while the same USB device is still on that AT port (and matches at_device).
modem() {
	local cache=/tmp/qbm-modem.json sigfile=/tmp/qbm-modem.sig out dev cfg cur_sig old_sig
	cfg=$(uci -q get qbm-diagd.main.at_device)
	if [ -s "$cache" ] && [ -s "$sigfile" ]; then
		json_load "$(cat "$cache")"
		json_get_var dev device
		if [ -n "$dev" ] && [ -c "$dev" ] && { [ -z "$cfg" ] || [ "$cfg" = auto ] || [ "$cfg" = "$dev" ]; }; then
			cur_sig=$(tty_usb_sig "$dev")
			old_sig=$(cat "$sigfile" 2>/dev/null)
			if [ -n "$cur_sig" ] && [ "$cur_sig" = "$old_sig" ]; then
				cat "$cache"
				return
			fi
		fi
		rm -f "$cache" "$sigfile"
	fi
	out=$(at_run "AT+CGMI" "AT+CGMM" "AT+GMR")
	echo "$out"
	case "$out" in
		*'"ok": true'*OK*)
			json_load "$out"
			json_get_var dev device
			cur_sig=$(tty_usb_sig "$dev")
			if [ -n "$cur_sig" ]; then
				echo "$out" > "$cache"
				echo "$cur_sig" > "$sigfile"
			fi
			;;
	esac
}

# AT+QNWPREFCFG (Quectel): one setting, checked, then read back.
qnwpref_set() {
	local key=$1 val=$2 tok
	case "$key" in
		nr5g_band|nsa_nr5g_band|lte_band|gw_band)
			case "$val" in
				''|*[!0-9:]*|:*|*:|*::*) at_fail "$key: colon-separated band numbers"; return ;;
			esac
			;;
		mode_pref)
			if [ "$val" != AUTO ]; then
				case "$val" in
					''|:*|*:|*::*) at_fail "mode_pref: AUTO or colon-separated RATs"; return ;;
				esac
				for tok in $(printf '%s' "$val" | tr ':' ' '); do
					case "$tok" in
						WCDMA|LTE|NR5G) ;;
						*) at_fail "mode_pref: unsupported RAT $tok"; return ;;
					esac
				done
			fi
			;;
		nr5g_disable_mode)
			case "$val" in
				0|1|2) ;;
				*) at_fail "nr5g_disable_mode: 0, 1 or 2"; return ;;
			esac
			;;
		ue_usage_setting)
			case "$val" in
				0|1) ;;
				*) at_fail "ue_usage_setting: 0 or 1"; return ;;
			esac
			;;
		*)
			at_fail "unsupported qnwpref key"
			return
			;;
	esac
	at_run "AT+QNWPREFCFG=\"$key\",$val" "AT+QNWPREFCFG=\"$key\""
}

# AT+GTACT (Fibocom): RAT and band lock. Numbers and commas only.
at_bands_set() {
	local rat=$1 p1=$2 p2=$3 bands=$4
	case "$rat" in ''|*[!0-9]*) at_fail "rat: a number"; return ;; esac
	case "$p1$p2" in *[!0-9]*) at_fail "preferred RAT: numbers"; return ;; esac
	case "$bands" in
		'') ;;
		*[!0-9,]*|,*|*,|*,,*) at_fail "bands: numbers separated by commas"; return ;;
	esac
	if [ -n "$bands" ]; then
		at_run "AT+GTACT=$rat,$p1,$p2,$bands" "AT+GTACT?"
	else
		at_run "AT+GTACT=$rat,$p1,$p2" "AT+GTACT?"
	fi
}

# "Restore MTK DIAG profile": qbm-diagd writes the FM350's original trace
# filters back; trimming then stays off (mtk_trim 0) until it is checked again.
mtk_restore() {
	local out
	out=$(query '{"cmd":"mtk_restore"}')
	case "$out" in
		*'"ok":true'*)
			uci -q set qbm-diagd.main.mtk_trim=0
			uci -q commit qbm-diagd
			;;
	esac
	echo "$out"
}

ports() {
	local t name dev intf usb drv

	json_init
	json_add_array ports
	for t in /sys/class/tty/ttyUSB* /sys/class/tty/ttyACM*; do
		[ -e "$t/device" ] || continue
		name=${t##*/}
		dev=$(readlink -f "$t/device")
		intf=${dev%/*}
		usb=${intf%/*}
		drv=$(readlink "$t/device/driver")
		json_add_object
		json_add_string dev "/dev/$name"
		json_add_string driver "${drv##*/}"
		json_add_string interface "$(read_attr "$intf/bInterfaceNumber")"
		json_add_string class "$(read_attr "$intf/bInterfaceClass")/$(read_attr "$intf/bInterfaceSubClass")/$(read_attr "$intf/bInterfaceProtocol")"
		json_add_string usb_id "$(read_attr "$usb/idVendor"):$(read_attr "$usb/idProduct")"
		json_add_string manufacturer "$(read_attr "$usb/manufacturer")"
		json_add_string product "$(read_attr "$usb/product")"
		json_close_object
	done
	json_close_array
	json_add_array qmi
	for t in /sys/class/usbmisc/cdc-wdm*; do
		[ -e "$t/device" ] || continue
		name=${t##*/}
		dev=$(readlink -f "$t/device")
		usb=${dev%/*}
		drv=$(readlink "$t/device/driver")
		json_add_object
		json_add_string dev "/dev/$name"
		json_add_string driver "${drv##*/}"
		json_add_string interface "$(read_attr "$dev/bInterfaceNumber")"
		json_add_string usb_id "$(read_attr "$usb/idVendor"):$(read_attr "$usb/idProduct")"
		json_add_string product "$(read_attr "$usb/product")"
		json_close_object
	done
	json_close_array
	json_add_string qmi_device "$(qmi_dev)"
	json_add_string at_device "$(at_dev)"
	json_dump
}

case "$1" in
	list)
		echo '{ "stats": { "sim": 1 }, "status": { }, "ports": { }, "qmi_query": { "sim": 1, "cmd": "query" }, "qmi": { "sim": 1, "request": "{}" }, "serving": { "sim": 1 }, "operator": { "sim": 1, "mcc": "000", "mnc": "00" }, "airplane": { }, "reconnect": { }, "refresh_ip": { }, "at": { "cmd": "AT" }, "modem": { }, "at_bands": { }, "at_bands_set": { "rat": "20", "p1": "", "p2": "", "bands": "" }, "qnwpref_get": { }, "qnwpref_set": { "key": "", "value": "" }, "at_serving": { }, "at_serving_qcom": { }, "mtk_restore": { } }'
		;;
	call)
		AT_WHO=$2
		case "$2" in
			stats)
				read -r input
				json_load "$input"
				json_get_var sim sim
				[ "$sim" = 2 ] || sim=1
				query "{\"cmd\":\"stats\",\"sim\":$sim}"
				;;
			status)
				query '{"cmd":"version"}'
				;;
			ports)
				ports
				;;
			airplane)
				airplane_mode
				;;
			reconnect)
				reconnect_start
				;;
			refresh_ip)
				refresh_start
				;;
			modem)
				modem
				;;
			at_bands)
				at_run "AT+GTACT=?" "AT+GTACT?"
				;;
			at_bands_set)
				read -r input
				json_load "$input"
				json_get_var rat rat
				json_get_var p1 p1
				json_get_var p2 p2
				json_get_var bands bands
				at_bands_set "$rat" "$p1" "$p2" "$bands"
				;;
			qnwpref_get)
				# Reply order is fixed; bands.js reads them by position. policy_band
				# is what the modem accepts, rf_band the RF hardware (the fallback;
				# ue_capability_band is only the current lock on the RM551E).
				at_run 'AT+QNWPREFCFG="policy_band"' 'AT+QNWPREFCFG="rf_band"' \
					'AT+QNWPREFCFG="nr5g_band"' 'AT+QNWPREFCFG="nsa_nr5g_band"' \
					'AT+QNWPREFCFG="lte_band"' 'AT+QNWPREFCFG="gw_band"' \
					'AT+QNWPREFCFG="mode_pref"' 'AT+QNWPREFCFG="nr5g_disable_mode"' \
					'AT+QNWPREFCFG="ue_usage_setting"'
				;;
			qnwpref_set)
				read -r input
				json_load "$input"
				json_get_var key key
				json_get_var val value
				qnwpref_set "$key" "$val"
				;;
			at_serving)
				at_run "AT+COPS?" "AT+GTCCINFO?"
				;;
			at_serving_qcom)
				at_run 'AT+QENG="servingcell"' "AT+QCAINFO" "AT+QSPN" "AT+CEREG?" "AT+C5GREG?" "AT+COPS?"
				;;
			mtk_restore)
				mtk_restore
				;;
			at)
				read -r input
				json_load "$input"
				json_get_var cmd cmd
				at_send "$cmd"
				;;
			qmi_query)
				read -r input
				json_load "$input"
				json_get_var sim sim
				json_get_var cmd cmd
				case "$cmd" in
					query|query_hardware|query_lte_cell_lock|query_nr_cell_lock|version) ;;
					*) cmd=query ;;
				esac
				qmi "$sim" "{\"cmd\":\"$cmd\"}"
				;;
			serving)
				read -r input
				json_load "$input"
				json_get_var sim sim
				[ "$sim" = 2 ] || sim=1
				qmi "$sim" "{\"cmd\":\"nas_read\",\"sim\":$sim,\"reads\":[\"004d\",\"004f\",\"0043\",\"0031\",\"00d2\",\"00ac\"]}"
				;;
			operator)
				read -r input
				json_load "$input"
				json_get_var sim sim
				json_get_var mcc mcc
				json_get_var mnc mnc
				[ "$sim" = 2 ] || sim=1
				case "$mcc" in [0-9][0-9][0-9]) ;; *) echo '{"ok":false,"error":{"stage":"bad_request","message":"mcc: 3 digits"}}'; exit 0 ;; esac
				case "$mnc" in [0-9][0-9]|[0-9][0-9][0-9]) ;; *) echo '{"ok":false,"error":{"stage":"bad_request","message":"mnc: 2 or 3 digits"}}'; exit 0 ;; esac
				qmi "$sim" "{\"cmd\":\"nas_read\",\"sim\":$sim,\"reads\":[\"0025\",\"0044:$(plmn_payload "$mcc" "$mnc")\"]}"
				;;
			qmi)
				read -r input
				json_load "$input"
				json_get_var sim sim
				json_get_var request request
				qmi "$sim" "$request"
				;;
		esac
		;;
esac
